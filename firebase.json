{
  "hosting": {
    "public": "Persite/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
   "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "personal-api", "region": "us-central1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}